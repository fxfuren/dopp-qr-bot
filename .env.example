# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Yandex Disk OAuth Token (получить на https://oauth.yandex.ru/)
YANDEX_DISK_TOKEN=your_yandex_disk_token_here

# Путь к папке на Яндекс Диске с PDF файлами
YADISK_FOLDER=/dopps

# Временная директория для скачанных файлов
TMP_DIR=/tmp/dopp_bot

# Разрешение для рендеринга PDF в изображение
QR_DPI=150

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
